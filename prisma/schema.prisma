generator client {
  provider      = "prisma-client-js"
  // Outside node_modules to avoid Windows EPERM when AV/indexers lock DLLs under node_modules\.prisma
  output        = "../src/generated/prisma-client"
  // Vercel / Linux serverless (postinstall + local generate)
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

// Prisma forbids env() on `provider` (deterministic migrations). `DB_PROVIDER` in `.env` is applied
// by `scripts/sync-datasource-provider.js` before any Prisma CLI invocation. Allowed: sqlite | postgresql.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  viewer
  analyst
  admin
}

enum RecordType {
  income
  expense
}

model User {
  id           String              @id @default(uuid())
  email        String              @unique
  passwordHash String
  role         Role                @default(viewer)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  records      FinancialRecord[]
}

/// Financial ledger line item (table: `financial_records`).
model FinancialRecord {
  id          String     @id @default(uuid())
  amount      Decimal
  type        RecordType
  category    String
  date        DateTime
  notes       String?
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  isDeleted   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([createdById, date])
  @@index([isDeleted, date])
  @@index([isDeleted, category])
  @@index([isDeleted, type])
  @@map("financial_records")
}
