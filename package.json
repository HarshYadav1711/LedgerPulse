{
  "name": "ledgerpulse",
  "version": "1.0.0",
  "private": true,
  "description": "LedgerPulse API (scaffold)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "npx tsc -p tsconfig.build.json",
    "start": "prisma migrate deploy && npm run build && node --env-file=.env dist/server.js",
    "dev": "prisma migrate deploy && npx tsc -p tsconfig.build.json --watch",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "prisma": "^6.19.0",
    "typescript": "^5.8.2"
  }
}
