{
  "name": "ledgerpulse",
  "version": "1.0.0",
  "private": true,
  "description": "LedgerPulse — modular finance API (Express, Prisma, JWT, RBAC)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node scripts/prisma-generate.js",
    "build": "npx tsc -p tsconfig.build.json && node scripts/copy-prisma-client-to-dist.js",
    "build:copy-client": "node scripts/copy-prisma-client-to-dist.js",
    "start": "node scripts/run-prisma.js migrate deploy && npm run build && node --env-file=.env dist/server.js",
    "dev": "node scripts/run-prisma.js migrate deploy && nodemon",
    "test": "jest --runInBand",
    "prisma:generate": "node scripts/prisma-generate.js",
    "db:migrate": "node scripts/run-prisma.js migrate dev",
    "db:studio": "node scripts/run-prisma.js studio",
    "db:seed": "node scripts/run-prisma.js migrate deploy && npx tsx prisma/seed.ts",
    "db:reset": "node scripts/run-prisma.js migrate reset --force",
    "db:push": "node scripts/run-prisma.js db push",
    "prisma:validate": "node scripts/run-prisma.js validate"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^29.7.0",
    "prisma": "^6.19.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "nodemon": "^3.1.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
