# -----------------------------------------------------------------------------
# Database (dual setup)
# -----------------------------------------------------------------------------
# DB_PROVIDER: sqlite | postgresql — selects the Prisma datasource before any CLI
# command (see scripts/sync-datasource-provider.js). Prisma does not support
# provider = env("DB_PROVIDER") inside schema.prisma (P1012); this env var is the
# source of truth and is synced into the literal provider line automatically.
#
# DATABASE_URL: connection string for the active provider (validated by Prisma).
# -----------------------------------------------------------------------------

# --- Default: SQLite (local file; matches committed prisma/migrations SQL) ---
DB_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

# --- Example: PostgreSQL (use empty DB + schema sync; see README) ---
# DB_PROVIDER=postgresql
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ledgerpulse?schema=public"
#
# --- Vercel / serverless: Postgres only (set the same vars in Vercel → Env, including Build) ---
# DB_PROVIDER=postgresql
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/ledgerpulse?sslmode=require"

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
JWT_SECRET="change-me-min-16-chars!!"
# Optional. Default 12. Lower values speed up local dev/tests (not for production).
# BCRYPT_ROUNDS=12
